NODE_ENV=development
PORT=5000

# Database Configuration (For Local or Cloud MySQL like TiDB / Aiven)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=thegaaverp
DB_PORT=3306
# Set DB_SSL=true when using cloud databases (TiDB Cloud, Aiven, etc.)
DB_SSL=false

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_access_token_key_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_min_32_chars
JWT_REFRESH_EXPIRES=7d

# CORS & Allowed Origins (comma-separated if multiple, e.g. https://your-app.vercel.app)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

TZ=Asia/Kolkata
SHOPIFY_API_VERSION=2025-01
